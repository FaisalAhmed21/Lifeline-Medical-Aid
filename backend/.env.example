# Server Configuration
PORT=5000
NODE_ENV=development

# Database
## Example MongoDB settings
# Use MongoDB Atlas (SRV) - replace placeholders with your values:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lifeline_db?retryWrites=true&w=majority
# Or use local MongoDB for development:
MONGODB_URI=mongodb://localhost:27017/lifeline_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://lifeline-medical-aid-backend.onrender.com/api/auth/google/callback

# Frontend URL
CLIENT_URL=https://lifeline-medical-aid-fbc2e.web.app/

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (for verification emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
